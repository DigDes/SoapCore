<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ServerWithUi</RootNamespace>
    <!-- The XML documentation file (ServerWithUi.xml, next to the assembly) feeds the descriptions of the explorer: see IncludeXmlComments in Program.cs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SoapCore\SoapCore.csproj" />
    <ProjectReference Include="..\..\src\SoapCore.UI\SoapCore.UI.csproj" />
    <ProjectReference Include="..\Models\Models.csproj" />
  </ItemGroup>

</Project>
